rules_version = '2';
service cloud.firestore {
  match /databases/{db}/documents {
    // Data pribadi host (cadangan pengaturan, penonton setia, ringkasan live, token notifikasi)
    match /users/{uid}/{document=**} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }
    // Ruang tamu live: host (login) membuat ruangan, tamu dari browser boleh antre & bertukar sinyal WebRTC
    match /rooms/{room} {
      allow read: if true;
      allow write: if request.auth != null;
      match /peers/{peer} {
        allow read, create: if true;
        allow update: if true;
        allow delete: if request.auth != null;
        match /{sub=**} { allow read, write: if true; }
      }
    }
  }
}
