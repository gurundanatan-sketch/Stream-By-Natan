{
  "hosting": {
    "public": "web",
    "ignore": [
      "firebase.json",
      "**/node_modules/**"
    ],
    "headers": [
      {
        "source": "**",
        "headers": [
          {
            "key": "Permissions-Policy",
            "value": "camera=(self), microphone=(self), display-capture=(self)"
          }
        ]
      },
      {
        "source": "/.well-known/assetlinks.json",
        "headers": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ]
      }
    ],
    "cleanUrls": false,
    "rewrites": [
      {
        "source": "/@**",
        "destination": "/profile/index.html"
      }
    ]
  },
  "firestore": {
    "rules": "firestore.rules"
  }
}